# Replace pdf.yourdomain.com with your real subdomain (DNS A record -> your VM's public IP).
# Caddy obtains and auto-renews the SSL certificate (HTTPS) for you.
pdf.yourdomain.com {
	encode gzip

	# --- Public API: only /v1/* and /health ---
	# (protected by the API key; the server also applies rate limiting)
	@public path /v1/* /health
	handle @public {
		reverse_proxy pdf-studio:8088
	}

	# --- Everything else (panel, visual editor, /api/*, /docs): PRIVATE ---
	# Behind username + password. Generate the hash with:
	#   docker run --rm caddy caddy hash-password --plaintext 'YOUR_PASSWORD'
	handle {
		basic_auth {
			admin REPLACE_WITH_THE_HASH
		}
		reverse_proxy pdf-studio:8088
	}
}
